<mxfile host="app.diagrams.net">
  <diagram name="Module Hierarchy">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== TOP MODULE ===== -->

        <mxCell id="main" value="CookMate System"
        style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
        vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== LEVEL 2 ===== -->

        <mxCell id="ui" value="User Interface"
        style="rounded=1;whiteSpace=wrap;html=1;"
        vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="admin" value="Admin Module"
        style="rounded=1;whiteSpace=wrap;html=1;"
        vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== LEVEL 3 ===== -->

        <mxCell id="engine" value="Recommendation Engine"
        style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
        vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== LEVEL 4 ===== -->

        <mxCell id="processor" value="Ingredient Processor"
        style="rounded=1;whiteSpace=wrap;html=1;"
        vertex="1" parent="1">
          <mxGeometry x="120" y="340" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="scoring" value="Scoring System"
        style="rounded=1;whiteSpace=wrap;html=1;"
        vertex="1" parent="1">
          <mxGeometry x="340" y="340" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="nutrition" value="Nutrition Calculator"
        style="rounded=1;whiteSpace=wrap;html=1;"
        vertex="1" parent="1">
          <mxGeometry x="560" y="340" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="shopping" value="Shopping Module"
        style="rounded=1;whiteSpace=wrap;html=1;"
        vertex="1" parent="1">
          <mxGeometry x="780" y="340" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== LEVEL 5 ===== -->

        <mxCell id="dataset" value="Recipe Dataset"
        style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
        vertex="1" parent="1">
          <mxGeometry x="420" y="460" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== CONNECTIONS ===== -->

        <!-- Main to UI/Admin -->
        <mxCell edge="1" source="main" target="ui" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="main" target="admin" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UI to Engine -->
        <mxCell edge="1" source="ui" target="engine" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Engine to Modules -->
        <mxCell edge="1" source="engine" target="processor" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="engine" target="scoring" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="engine" target="nutrition" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="engine" target="shopping" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Modules to Dataset -->
        <mxCell edge="1" source="processor" target="dataset" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="scoring" target="dataset" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="nutrition" target="dataset" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell edge="1" source="shopping" target="dataset" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>